# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Solo servidor (nunca NEXT_PUBLIC_): escribe conexiones, tokens en Vault y webhooks. Salta RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio público de la app, sin barra final. Base de los redirect_uri de Shopify y Meta.
APP_URL=http://localhost:3000
# Firma el `state` de OAuth (al menos 32 caracteres aleatorios).
OAUTH_STATE_SECRET=
# Bearer del cron diario /api/cron/connections (Vercel Cron lo envía solo si está definido).
CRON_SECRET=

# App de Shopify (Dev Dashboard → Client credentials). Alcances y webhooks: shopify.app.toml.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Versión trimestral del Admin API (AAAA-01|04|07|10); igual a webhooks.api_version del toml.
SHOPIFY_API_VERSION=2026-07

# App de Meta de tipo Business con Facebook Login for Business.
META_APP_ID=
META_APP_SECRET=
# Id de la configuración de FLfB (permisos: ads_read, ads_management, business_management, pages_show_list).
META_LOGIN_CONFIG_ID=
# Versión estable vigente de la Graph API (verifícala en el changelog de Meta).
META_GRAPH_VERSION=v24.0
